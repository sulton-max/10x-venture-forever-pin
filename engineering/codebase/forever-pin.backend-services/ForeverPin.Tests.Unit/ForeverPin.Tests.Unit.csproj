<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Pure-logic tier: no I/O, no DB, no host boot. Just xUnit + the SUTs (routing evaluation, code rendering, plan-limit math). DB/host concerns live in ForeverPin.Tests.Integration / ForeverPin.Tests.E2E. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Code-rendering engine now lives in the SDK (extracted v0.6); these tests exercise it directly. -->
    <PackageReference Include="WoW2.Sdk.Backend.Beta" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The systems under test: code generation (ForeverPin.Codes), the routing evaluator (ForeverPin.Redirect.Api), and PlanLimits (ForeverPin.Api). Pure types only; the global `Program` of each host is never referenced, so no extern aliases are needed. -->
  <ItemGroup>
    <ProjectReference Include="..\ForeverPin.Domain\ForeverPin.Domain.csproj" />
    <ProjectReference Include="..\ForeverPin.Application\ForeverPin.Application.csproj" />
    <ProjectReference Include="..\ForeverPin.Infrastructure\ForeverPin.Infrastructure.csproj" />
    <ProjectReference Include="..\ForeverPin.Redirect.Api\ForeverPin.Redirect.Api.csproj" />
  </ItemGroup>

</Project>
