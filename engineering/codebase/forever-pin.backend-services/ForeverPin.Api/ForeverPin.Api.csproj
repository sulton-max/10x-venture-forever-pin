<Project Sdk="Microsoft.NET.Sdk.Web">

    <ItemGroup>
        <!-- Mediator (ISender.SendAsync) and AppResult.Match for the controllers. -->
        <PackageReference Include="WoW2.Sdk.Backend.Beta" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ForeverPin.Application\ForeverPin.Application.csproj" />
        <ProjectReference Include="..\ForeverPin.Infrastructure\ForeverPin.Infrastructure.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <SpaRoot>$(MSBuildProjectDirectory)/../../forever-pin.frontend-services/</SpaRoot>
    </PropertyGroup>
  <Target Name="BuildSpa" BeforeTargets="PrepareForBuild;ResolveProjectStaticWebAssets"
          Condition="'$(BuildSpa)' != 'false' and '$(DesignTimeBuild)' != 'true' and '$(NoBuild)' != 'true'">
    <Error Condition="!Exists('$(SpaRoot)package.json')"
           Text="SpaRoot must point to the frontend workspace directory." />
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(SpaRoot)" />
    <Exec Command="pnpm run deploy" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <Content Remove="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Replace('\', '/').StartsWith('wwwroot/'))" />
      <Content Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
