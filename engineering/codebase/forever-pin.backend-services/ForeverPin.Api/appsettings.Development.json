{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Billing": {
    "_comment": "The Vite dev server serves the app in development, so Stripe returns there.",
    "SuccessUrl": "https://localhost:7024/app/billing?status=success",
    "CancelUrl": "https://localhost:7024/app/billing?status=cancelled",
    "PortalReturnUrl": "https://localhost:7024/app/billing"
  },
  "RateLimits": {
    "_comment": "Development and test hosts share one loopback client, so budgets stay out of the way here.",
    "Policies": {
      "api": {
        "PermitLimit": 100000
      },
      "sessions": {
        "PermitLimit": 100000
      },
      "previews": {
        "PermitLimit": 100000
      },
      "writes": {
        "PermitLimit": 100000
      },
      "images": {
        "PermitLimit": 100000
      }
    }
  }
}
