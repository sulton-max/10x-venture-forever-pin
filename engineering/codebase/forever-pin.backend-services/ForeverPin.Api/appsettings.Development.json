{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "RateLimits": {
    "_comment": "Development and test hosts share one loopback client, so budgets stay out of the way here.",
    "Policies": {
      "api": {
        "PermitLimit": 100000
      },
      "sessions": {
        "PermitLimit": 100000
      },
      "previews": {
        "PermitLimit": 100000
      },
      "writes": {
        "PermitLimit": 100000
      },
      "images": {
        "PermitLimit": 100000
      }
    }
  }
}
