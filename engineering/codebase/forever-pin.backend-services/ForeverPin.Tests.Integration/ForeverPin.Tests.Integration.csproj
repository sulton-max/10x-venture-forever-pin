<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Genuine integration tier: repository / config-store branches NOT observable over HTTP (cascade delete, ExecuteUpdate, audit stamping, single-row upsert, Stripe-id lookup, type round-trips, the cached config store). -->
  <!-- SDK Testing.Data: the provider-switchable RelationalTestDb (Postgres container or in-memory SQLite, via TestSetupOptions) backing the repository tests. Transitively brings the base Testing package (PostgresFixture). -->
  <ItemGroup>
    <PackageReference Include="WoW2.Sdk.Backend.Beta.Testing.Data" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The repositories under test live in ForeverPin.Api; the routing/config-store types live in ForeverPin.Redirect.Api. No host boot here — these tests drive the persistence layer directly against the test DB. -->
  <ItemGroup>
    <ProjectReference Include="..\ForeverPin.Domain\ForeverPin.Domain.csproj" />
    <ProjectReference Include="..\ForeverPin.Persistence\ForeverPin.Persistence.csproj" />
    <ProjectReference Include="..\ForeverPin.Application\ForeverPin.Application.csproj" />
    <ProjectReference Include="..\ForeverPin.Infrastructure\ForeverPin.Infrastructure.csproj" />
    <ProjectReference Include="..\ForeverPin.Redirect.Api\ForeverPin.Redirect.Api.csproj" />
  </ItemGroup>

</Project>
