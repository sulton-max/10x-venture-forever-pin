{
  "name": "forever-pin-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @foreverpin/web dev",
    "build": "pnpm -r --if-present build",
    "deploy": "node scripts/deploy.mjs",
    "preview": "pnpm --filter @foreverpin/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
