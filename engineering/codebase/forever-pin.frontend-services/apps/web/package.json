{
  "name": "@foreverpin/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "ForeverPin's Vue product and marketing application.",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:http": "vite --mode http",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && pnpm check:sfc",
    "check:sfc": "node scripts/check-sfc.mjs",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write src tests e2e scripts *.ts *.mjs *.json index.html",
    "format:check": "prettier --check src tests e2e scripts *.ts *.mjs *.json index.html",
    "lint": "eslint .",
    "test:browser": "vite build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@tanstack/vue-query": "^5.102.8",
    "@wow-two-beta/fe": "0.0.26",
    "lucide-vue-next": "^0.460.0",
    "qrcode": "^1.5.4",
    "temporal-polyfill": "^1.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.0.0",
    "vite-plugin-mkcert": "^1.17.8",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
