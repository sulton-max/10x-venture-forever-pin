# .NET build output
bin/
obj/
*.user

# Frontend output served by the Api (`pnpm -C engineering/codebase/forever-pin.frontend-services run deploy`)
engineering/codebase/forever-pin.backend-services/ForeverPin.Api/wwwroot/

# Settings files: a machine's own (appsettings.Local.json, read on a local run) and a deployed target's
